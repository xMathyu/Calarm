    "Pon la foto del cumpleañero o un símbolo a cada alarma." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a birthday photo or a symbol to each alarm."
          }
