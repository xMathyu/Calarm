    },
    "Las personas que invites podrán ver, crear, editar y borrar TODAS tus alarmas en tu nombre. Lo que ellas programen sonará en tu teléfono. Tú puedes revocar el acceso en cualquier momento." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People you invite will be able to see, create, edit, and delete ALL your alarms on your behalf. Whatever they schedule will ring on your phone. You can revoke access at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas que invites podrán ver, crear, editar y borrar TODAS tus alarmas en tu nombre. Lo que ellas programen sonará en tu teléfono. Tú puedes revocar el acceso en cualquier momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas que você convidar poderão ver, criar, editar e apagar TODOS os seus alarmes em seu nome. O que elas agendarem vai tocar no seu celular. Você pode revogar o acesso a qualquer momento."
          }
        }
      }
    },
