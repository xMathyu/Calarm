    "Calarmi" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi"
          }
        }
      }
    },
    "Calarmi es una app de alarmas para eventos personales: cumpleaños, aniversarios, recordatorios y más." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi is an alarm app for personal events: birthdays, anniversaries, reminders, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi es una app de alarmas para eventos personales: cumpleaños, aniversarios, recordatorios y más."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi é um app de alarmes para eventos pessoais: aniversários, datas especiais, lembretes e mais."
          }
        }
      }
    },
    "Calarmi lee tu Calendario y le pone hasta 3 avisos a cada evento. Si es una reunión de Teams, Zoom o Meet, aparece el botón para unirte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi reads your Calendar and gives each event up to 3 alerts. If it's a Teams, Zoom or Meet call, a Join button appears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi lee tu Calendario y le pone hasta 3 avisos a cada evento. Si es una reunión de Teams, Zoom o Meet, aparece el botón para unirte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi lê seu Calendário e coloca até 3 alertas em cada evento. Se for uma reunião do Teams, Zoom ou Meet, aparece o botão para entrar."
          }
        }
      }
    },
    "Calarmi mira todos tus calendarios, incluidos los que agregues después." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi watches every one of your calendars, including any you add later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi mira todos tus calendarios, incluidos los que agregues después."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi acompanha todos os seus calendários, inclusive os que você adicionar depois."
          }
        }
      }
    },
    "Calarmi necesita acceso a tu calendario para detectar reuniones." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi needs calendar access to detect meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi necesita acceso a tu calendario para detectar reuniones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi precisa de acesso ao seu calendário para detectar reuniões."
          }
        }
      }
    },
    "Calarmi necesita la cámara para leer el código. Actívala en Ajustes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi needs the camera to read the code. Turn it on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi necesita la cámara para leer el código. Actívala en Ajustes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi precisa da câmera para ler o código. Ative em Ajustes."
          }
        }
      }
    },
    "Calarmi necesita permiso para leer tus eventos y ponerles alarma." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi needs permission to read your events and set alarms for them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi necesita permiso para leer tus eventos y ponerles alarma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi precisa de permissão para ler seus eventos e criar alarmes para eles."
          }
        }
      }
    },
    "Calarmi no puede leer tus eventos. Toca Abrir Ajustes y en Calendarios elige «Acceso total»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi can't read your events. Tap Open Settings, and under Calendars choose “Full Access”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarmi no puede leer tus eventos. Toca Abrir Ajustes y en Calendarios elige «Acceso total»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calarmi não consegue ler seus eventos. Toque em Abrir Ajustes e, em Calendários, escolha “Acesso Total”."
          }
        }
