          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarm es una app de alarmas para eventos personales: cumpleaños, aniversarios, recordatorios y más."
          }
        }
      }
    },
    "Calarm lee tu Calendario y le pone hasta 3 avisos a cada evento. Si es una reunión de Teams, Zoom o Meet, aparece el botón para unirte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarm reads your Calendar and gives each event up to 3 alerts. If it's a Teams, Zoom or Meet call, a Join button appears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calarm lee tu Calendario y le pone hasta 3 avisos a cada evento. Si es una reunión de Teams, Zoom o Meet, aparece el botón para unirte."
          }
        }
      }
    },
