    "Pago único. Plus queda en todos tus dispositivos con la misma cuenta de Apple." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time payment. Plus stays on all your devices with the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pago único. Plus queda en todos tus dispositivos con la misma cuenta de Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagamento único. O Plus fica em todos os seus dispositivos com a mesma Conta Apple."
          }
        }
      }
    },
    "Se renueva sola cada año hasta que la canceles. Puedes cancelarla en Ajustes › tu nombre › Suscripciones, al menos 24 horas antes de la renovación." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renews automatically every year until you cancel. You can cancel in Settings › your name › Subscriptions, at least 24 hours before it renews."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva sola cada año hasta que la canceles. Puedes cancelarla en Ajustes › tu nombre › Suscripciones, al menos 24 horas antes de la renovación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente todo ano até você cancelar. Você pode cancelar em Ajustes › seu nome › Assinaturas, pelo menos 24 horas antes da renovação."
          }
        }
      }
    },
