    "Pon una alarma mañana a las 8am para el pastillero" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set an alarm tomorrow 8am for medication"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una alarma mañana a las 8am para el pastillero"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um alarme para amanhã às 8h para o remédio"
          }
        }
      }
    },
    "Ponle la foto de la persona y se repite cada año. Cada 2 semanas, los lunes y miércoles, cada 21 días: la recurrencia que necesites." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the person's photo and it repeats every year. Every 2 weeks, Mondays and Wednesdays, every 21 days — whatever recurrence you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle la foto de la persona y se repite cada año. Cada 2 semanas, los lunes y miércoles, cada 21 días: la recurrencia que necesites."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a foto da pessoa e ele se repete todo ano. A cada 2 semanas, às segundas e quartas, a cada 21 dias: a recorrência que você precisar."
          }
        }
      }
    },
    "Ponle un nombre a la alarma para poder guardarla." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the alarm a name so it can be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle un nombre a la alarma para poder guardarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um nome ao alarme para poder salvá-lo."
          }
        }
      }
    },
    "Ponle un nombre para reconocerla, por ejemplo «Tomar pastilla»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give it a name you'll recognize, for example “Take pill”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle un nombre para reconocerla, por ejemplo «Tomar pastilla»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um nome para reconhecê-lo, por exemplo “Tomar remédio”."
          }
        }
      }
    },
    "Pospone la alarma según el intervalo configurado." : {
      "localizations" : {
        "en" : {
