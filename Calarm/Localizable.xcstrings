    "Para guardar tus alarmas, abre Ajustes y en Calendarios elige «Acceso total» para Calarmi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save your alarms, open Settings and under Calendars choose “Full Access” for Calarmi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guardar tus alarmas, abre Ajustes y en Calendarios elige «Acceso total» para Calarmi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para salvar seus alarmes, abra Ajustes e, em Calendários, escolha “Acesso Total” para o Calarmi."
          }
        }
      }
    },
