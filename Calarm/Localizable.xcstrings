    "La compra necesita una aprobación, por ejemplo de quien organiza En familia. Plus se activará solo cuando se apruebe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase needs approval, for example from your Family Sharing organizer. Plus will turn on by itself once it's approved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra necesita una aprobación, por ejemplo de quien organiza En familia. Plus se activará solo cuando se apruebe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A compra precisa de aprovação, por exemplo do organizador do Compartilhamento Familiar. O Plus será ativado sozinho quando ela for aprovada."
          }
        }
      }
