# Xcode / build artifacts (never commit)
artif*-from-xcode/
*.ipa
*.xcarchive
DerivedData/
build/
.DS_Store

# App Store Connect API keys — never commit
*.p8

# Python bytecode (ci_scripts/asc.py)
__pycache__/
*.pyc

# Configuración de Firebase: el repo es público. Xcode Cloud la escribe desde la
# variable secreta GOOGLE_SERVICE_INFO_PLIST_BASE64 (ci_scripts/ci_pre_xcodebuild.sh);
# en local, copiarla de calarmi-firebase/.secrets/.
Calarm/GoogleService-Info.plist
